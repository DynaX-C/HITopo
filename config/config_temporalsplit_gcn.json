{
    "data_mode": "temporalsplit",
    "train_graph_pt_path": "./data_processed/temporalsplit/train_graphs_temporalsplit.pt",
    "valid_graph_pt_path": "./data_processed/temporalsplit/valid_graphs_temporalsplit.pt",

    "casf13_graph_pt_path": "./data_processed/temporalsplit/test_graphs_temporalsplit_casf13.pt",
